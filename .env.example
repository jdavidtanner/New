# Copy to .env and fill in values
HF_TOKEN=your_huggingface_token_here
HF_HOME=/path/to/hf_cache
TRANSFORMERS_CACHE=/path/to/transformers_cache

# Override default device
CUDA_VISIBLE_DEVICES=0

# Optional W&B logging
WANDB_API_KEY=
WANDB_PROJECT=curvature-semantics
WANDB_ENTITY=

# Results directory
CURVATURE_OUTPUT_ROOT=results

# Website-design tooling (.mcp.json)
# Required by the 21st.dev Magic MCP server. Get a key at https://21st.dev/magic/console
MAGIC_API_KEY=

# GitHub MCP server (remote/HTTP mode). Fine-grained or classic PAT.
# Create at https://github.com/settings/personal-access-tokens
GITHUB_PAT=
