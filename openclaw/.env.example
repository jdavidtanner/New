# PostgreSQL (must have pgvector and Apache AGE extensions)
DATABASE_URL=postgresql://user:password@localhost:5432/openclaw

# OpenAI — used for embeddings (text-embedding-3-small, 1536 dims)
OPENAI_API_KEY=sk-...

# Anthropic — used for the LLM planner and belief revision
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5

# Context budget (tokens). Adjust per model.
MAX_CONTEXT_TOKENS=100000

# Retrieval limits
SEMANTIC_RETRIEVAL_LIMIT=12
TEMPORAL_WINDOW_HOURS=168
GRAPH_HOP_LIMIT=2

# Skill health check timeout (ms)
SKILL_HEALTH_TIMEOUT_MS=5000
