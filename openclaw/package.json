{
  "name": "openclaw",
  "version": "0.1.0",
  "description": "Fred/OpenClaw Memory Kernel — stateful reasoning system with temporal, semantic, graph, and belief memory",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "psql $DATABASE_URL -f schema.sql",
    "db:migrate:checkpointer": "tsx src/scripts/setup-checkpointer.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.53.0",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "dotenv": "^16.4.0",
    "openai": "^4.77.0",
    "pg": "^8.13.0",
    "pgvector": "^0.2.0",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
